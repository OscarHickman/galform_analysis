   "source": [
    "# Galaxy Bias Example
",
    "
",
    "This notebook demonstrates how to compute the galaxy bias $b(r) = \sqrt{\xi_{gal} / \xi_{halo}}$ using `galform_analysis`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt
",
    "from galform_analysis.src.analysis.correlation.correlation import (
",
    "    correlation_given_redshift_and_subvolume,
    halo_correlation_given_redshift_and_subvolume
",
    ")
",
    "from galform_analysis.src.analysis.correlation.galaxy_bias import compute_galaxy_bias
",
    "from galform_analysis.src.config import get_base_dir
",
    "
",
    "# Set parameters
",
    "iz_path = "/cosma5/data/durham/dc-hick2/Galform_Out/L800/lc16/iz155"
",
    "ivol = 0
",
    "
",
    "# 1. Compute correlations
",
    "xi_gal = correlation_given_redshift_and_subvolume(iz_path, ivol)
",
    "xi_halo = halo_correlation_given_redshift_and_subvolume(iz_path, ivol)
",
    "
",
    "# 2. Compute bias
",
    "bias_df = compute_galaxy_bias(xi_gal, xi_halo)
",
    "
",
    "# 3. Plot
",
    "plt.figure(figsize=(8, 6))
",
    "plt.plot(bias_df['r'], bias_df['bias'], 'o-')
",
    "plt.xscale('log')
",
    "plt.xlabel('r [Mpc/h]')
",
    "plt.ylabel('Galaxy Bias b(r)')
",
    "plt.title('Galaxy Bias Example')
",
    "plt.grid(True)
",
    "plt.show()"
   ]
  }
 ],
