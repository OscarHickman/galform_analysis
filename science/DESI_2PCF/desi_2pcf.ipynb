    "    ivol=example_ivol,\n",
    "    rbins=rbins,\n",
    "    nthreads=4,\n",
    "    base_dir=str(base_dir),\n",
    "    mhalo_min=mhalo_min,\n",
    " )\n",
    "\n",
    "if avg_result is not None:\n",
    "    print(f\"Data computed: averaged over {len(iz_nums)} redshifts for ivol {example_ivol}\")\n",
    "else:\n",
    "    print(f\"Failed to compute average correlation\")"
   ]
  },
